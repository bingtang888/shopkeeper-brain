    {
      "id": "QUvb6MrRHBUSz1UcIYync",
      "type": "text",
      "x": 4267.787170400524,
      "y": 94507.55114744784,
      "width": 2089.7998046875,
      "height": 180,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
