    {
      "id": "UcWZS8pHLP0lvg2ptgB88",
      "type": "text",
      "x": 4201.643042345495,
      "y": 98734.81137498366,
      "width": 2029.4998779296875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
